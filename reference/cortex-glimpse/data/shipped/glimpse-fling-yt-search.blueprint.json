    { "id": "wait", "type": "fling_tab_wait", "config": { "wait_until": "complete", "timeout_ms": 15000 } },
    { "id": "index", "type": "fling_tab_content_index", "config": { "query": "video" } },
    { "id": "close", "type": "fling_tab_close", "config": {} }
