{
  "schema": "cortex_blueprint_v1",
  "format": "fling",
  "id": "glimpse-yt-search",
  "title": "Glimpse YouTube hunt",
  "description": "Background-tab YouTube search for Glimpse. Not a hub-tick job. Does not steal the focused tab.",
  "version": 1,
