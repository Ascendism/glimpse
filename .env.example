# Discord OAuth2 Configuration
# Get these from https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Discord OAuth2 Redirect URI
# Default: http://localhost:8080/auth/discord/callback (for playtesting on port 8080)
# For production: https://yourdomain.com/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback

# Session Secret (generate a random string for production)
SESSION_SECRET=your_random_session_secret_here
