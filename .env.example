# Copy this file to .env in the project root (beside package.json).
# Discord Developer Portal > Your application > OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must match an OAuth2 redirect URL registered in Discord exactly.
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Persistent, writable directory for SQLite and table snapshots.
# Defaults to .data in the project root. Use an absolute persistent path in production.
# GLIMPSE_STATE_DIR=C:/app/glimpse-data
